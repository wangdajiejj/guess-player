.game {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--gp-bg, #f4f6f4);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--gp-line, rgba(0,0,0,0.06));
}

.tb-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #1f2421;
}

.tb-sub {
  font-size: 22rpx;
}

.tb-right {
  text-align: right;
}

.tb-num {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--gp-main, #0c5c3b);
}

.tb-slash {
  font-size: 24rpx;
  color: #9aa09c;
}

.tb-label {
  font-size: 20rpx;
}

.dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 18rpx 0;
  background: #fff;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot-left {
  background: #dfe3e0;
}

.dot-used {
  background: var(--gp-main, #0c5c3b);
}

.rows {
  flex: 1;
  overflow: hidden;
  padding: 16rpx 24rpx 0;
}

.gp-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;
  gap: 20rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #dfe3e0;
  border-top-color: var(--gp-main, #0c5c3b);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.btn-retry {
  width: 240rpx;
  height: 72rpx;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 8rpx;
}

/* 首次猜完后出现一次的操作提示（线索标签可点） */
.clue-tip {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #eaf3e6;
  border: 2rpx solid #cfe3c8;
  animation: tip-in 0.3s ease-out;
}

.clue-tip-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.clue-tip-txt {
  flex: 1;
  font-size: 24rpx;
  color: #3d7a3a;
  line-height: 1.5;
}

.clue-tip-x {
  padding: 0 8rpx;
  font-size: 34rpx;
  color: #8fae86;
  line-height: 1;
}

@keyframes tip-in {
  from { opacity: 0; transform: translateY(-10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
}

.finish-tip {
  text-align: center;
  padding: 40rpx 0 20rpx;
  font-size: 26rpx;
  color: var(--gp-main, #0c5c3b);
}

.safe-gap {
  height: 40rpx;
}

.bottom {
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--gp-line, rgba(0,0,0,0.06));
}

.btn-help {
  margin-top: 14rpx;
}
