/**
 * 游戏页视觉：
 *  - 背景是纯 CSS 画的「球场俯视」：中圈 + 两侧底线纹理，零图片素材
 *  - 剩余次数 <= 2 时数字变红并呼吸，制造一点紧张感
 *  - 机会轨道：走过的 ✓ 实心，当前光圈呼吸
 */
.game {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    radial-gradient(circle at 50% 34%, var(--gp-glow) 0%, rgba(255, 255, 255, 0) 26%),
    radial-gradient(circle at 50% 34%, transparent 0%, transparent 118rpx, rgba(12, 92, 59, 0.05) 119rpx, rgba(12, 92, 59, 0.05) 122rpx, transparent 123rpx),
    linear-gradient(180deg, var(--gp-bg-top) 0%, var(--gp-bg) 30%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 32rpx 18rpx;
  background: linear-gradient(135deg, #0c5c3b 0%, #148053 100%);
  color: #fff;
}

.tb-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.tb-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 4rpx;
}

.tb-right {
  text-align: right;
}

.tb-remain {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 2rpx;
}

.tb-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffd76a;
  line-height: 1.1;
}

.tb-num-danger {
  color: #ff8f6b;
  animation: num-pulse 1.1s ease-in-out infinite;
}

@keyframes num-pulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.18); }
}

.tb-slash {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.tb-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.tb-danger {
  animation: none;
}

/* ---------- 机会轨道 ---------- */

.dots {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  padding: 18rpx 0;
  background: #0c5c3b;
}

.dot {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  transition: all 0.25s ease;
}

.dot-left {
  background: rgba(255, 255, 255, 0.16);
}

.dot-used {
  background: #ffd76a;
  color: #7a5c00;
  transform: scale(0.86);
  font-weight: 700;
}

.dot-cur {
  background: rgba(255, 255, 255, 0.9);
  animation: dot-breathe 1.4s ease-in-out infinite;
}

@keyframes dot-breathe {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.45); }
  50%      { box-shadow: 0 0 0 10rpx rgba(255, 255, 255, 0); }
}

/* ---------- 线索区 ---------- */

.rows {
  flex: 1;
  overflow: hidden;
  padding: 16rpx 24rpx 0;
}

.gp-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;
  gap: 20rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--gp-holder);
  border-top-color: var(--gp-main);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.btn-retry {
  width: 240rpx;
  height: 72rpx;
  font-size: 28rpx;
}

/* ---------- 开局骨架屏：两张假线索卡 ---------- */

.sk-card {
  background: var(--gp-card);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

.sk-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.sk-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.sk-lines {
  margin-left: 18rpx;
  flex: 1;
}

.sk-bar {
  height: 26rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.sk-w44 { width: 44%; }
.sk-w28 { width: 28%; height: 20rpx; }

.sk-chips {
  display: flex;
  flex-wrap: wrap;
}

.sk-chip {
  height: 44rpx;
  border-radius: 10rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 标签条宽窄错开，别整整齐齐像进度条 */
.sk-c1 { width: 110rpx; }
.sk-c2 { width: 150rpx; }
.sk-c3 { width: 96rpx; }
.sk-c4 { width: 132rpx; }
.sk-c5 { width: 88rpx; }
.sk-c6 { width: 168rpx; }
.sk-c7 { width: 104rpx; }
.sk-c8 { width: 140rpx; }

/* 逐块错峰发亮，第二张卡整体再慢半拍 */
.sk-a .sk::after { animation-delay: 0s; }
.sk-b .sk::after { animation-delay: 0.45s; }

.sk-note {
  text-align: center;
  padding: 12rpx 0 24rpx;
  font-size: 24rpx;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1.2;
  animation: ball-float 2.8s ease-in-out infinite;
}

@keyframes ball-float {
  0%, 100% { transform: translateY(0) rotate(-8deg); }
  50%      { transform: translateY(-14rpx) rotate(8deg); }
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
}

/* 首次猜完后出现一次的操作提示（线索标签可点） */
.clue-tip {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--gp-green-bg);
  border: 2rpx solid var(--gp-green-dark);
  animation: tip-in 0.3s ease-out;
}

.clue-tip-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.clue-tip-txt {
  flex: 1;
  font-size: 24rpx;
  color: var(--gp-green-dark);
  line-height: 1.5;
}

.clue-tip-x {
  padding: 0 8rpx;
  font-size: 34rpx;
  color: var(--gp-text-mute);
  line-height: 1;
}

@keyframes tip-in {
  from { opacity: 0; transform: translateY(-10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.finish-tip {
  text-align: center;
  padding: 40rpx 0 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gp-main, #0c5c3b);
  animation: tip-in 0.35s ease-out;
}

.safe-gap {
  height: 40rpx;
}

/* ---------- 底部操作 ---------- */

.bottom {
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--gp-card);
  border-top: 1rpx solid var(--gp-line);
}

.btn-cta {
  height: 96rpx;
  font-size: 34rpx;
  background: linear-gradient(135deg, #0c5c3b 0%, #148053 60%, #1c9a63 100%);
  box-shadow: 0 10rpx 24rpx rgba(12, 92, 59, 0.24);
}

.btn-cta.gp-btn-disabled {
  background: var(--gp-disabled);
  box-shadow: none;
}

.btn-press {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-help {
  margin-top: 14rpx;
}
