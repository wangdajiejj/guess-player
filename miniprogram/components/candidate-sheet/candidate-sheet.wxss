.cs-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 900;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.cs-panel {
  background: var(--gp-card);
  border-radius: 28rpx 28rpx 0 0;
  height: 80vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  animation: cs-up 0.22s ease-out;
}

@keyframes cs-up {
  from { transform: translateY(60rpx); opacity: 0.6; }
  to   { transform: translateY(0); opacity: 1; }
}

.cs-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--gp-holder);
  margin: 16rpx auto 4rpx;
}

.cs-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 8rpx;
}

.cs-title-main {
  display: flex;
  align-items: baseline;
}

.cs-title-txt {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--gp-text);
}

.cs-count {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--gp-main, #0c5c3b);
  font-weight: 500;
}

.cs-close {
  font-size: 26rpx;
  color: var(--gp-text-mute);
}

/* ---------------- 条件区 ---------------- */

.cs-cond {
  padding: 6rpx 0 4rpx;
}

.cs-cond-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 10rpx;
}

.cs-cond-tip {
  font-size: 22rpx;
  color: var(--gp-text-mute);
}

.cs-cond-acts {
  display: flex;
  align-items: center;
}

.cs-act {
  font-size: 24rpx;
  color: var(--gp-main, #0c5c3b);
}

.cs-act-divider {
  margin: 0 10rpx;
  color: var(--gp-divider);
  font-size: 22rpx;
}

/* 条件标签换行铺开：全部可见，不横向滚动（滚动会静默截断后面的标签） */
.cs-cond-scroll {
  width: 100%;
}

.cs-cond-row {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
}

/* 未选中 = 描边空心；选中 = 判定色实心。两种状态必须一眼分开 */
.cs-chip {
  display: inline-flex;
  align-items: baseline;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
  background: var(--gp-chip-bg);
  color: var(--gp-chip-text);
  border: 2rpx solid rgba(0, 0, 0, 0.12);
}

.cs-chip-label {
  margin-right: 8rpx;
  font-size: 22rpx;
  opacity: 0.75;
}

/* 启用后按判定色实心显示，和线索卡里的颜色对得上 */
.cs-chip-on { font-weight: 500; }
.cs-chip-on.cs-chip-green { background: #6aaa64; color: #fff; border-color: #578f53; }
.cs-chip-on.cs-chip-amber { background: #c9b458; color: #fff; border-color: #a89349; }
.cs-chip-on.cs-chip-gray  { background: #787c7e; color: #fff; border-color: #63666a; }

@media (prefers-color-scheme: dark) {
  /* 深色下实心暗底太像选中态，未选中改成透明底 + 亮描边，只留"空心/实心"一个区别维度 */
  .cs-chip {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.26);
  }
}

.cs-cons {
  padding: 10rpx 32rpx 0;
  font-size: 22rpx;
  color: var(--gp-text-mute);
  line-height: 1.6;
}

.cs-cons-tip {
  color: var(--gp-text-mute);
}

.cs-cons-item {
  margin-right: 14rpx;
  color: var(--gp-chip-text);
}

.cs-hint {
  padding: 12rpx 32rpx 6rpx;
  font-size: 22rpx;
  color: var(--gp-text-mute);
  border-top: 1rpx solid var(--gp-line, rgba(0,0,0,0.06));
  margin-top: 12rpx;
}

/* ---------------- 列表 ---------------- */

.cs-list {
  flex: 1;
  overflow: hidden;
}

.cs-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 32rpx;
  border-bottom: 1rpx solid var(--gp-line, rgba(0,0,0,0.06));
}

.cs-item-hover {
  background: var(--gp-field-hi);
}

.cs-item-done {
  opacity: 0.45;
}

.cs-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.cs-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.cs-name {
  font-size: 30rpx;
  color: var(--gp-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

/* 8 项线索：两列铺开，label 浅灰 + 值深灰，横向对齐方便上下对比 */
.cs-cells {
  display: flex;
  flex-wrap: wrap;
}

.cs-cell {
  width: 50%;
  display: flex;
  align-items: baseline;
  min-width: 0;
  margin-bottom: 4rpx;
  padding-right: 12rpx;
  box-sizing: border-box;
}

.cs-cell-label {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--gp-text-mute);
  margin-right: 8rpx;
}

.cs-cell-value {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--gp-gray-dark);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cs-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--gp-amber-dark);
  background: var(--gp-amber-bg);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.cs-tag-done {
  color: var(--gp-chip-text);
  background: var(--gp-gray-bg);
}

.cs-capped {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--gp-amber-dark);
  background: var(--gp-amber-bg);
  white-space: pre-line;
}

.cs-empty {
  padding: 120rpx 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--gp-text-mute);
  line-height: 1.8;
}

.cs-empty text {
  display: block;
}
