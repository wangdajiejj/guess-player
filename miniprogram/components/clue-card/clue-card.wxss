.cc-card {
  background: var(--gp-card);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  /* 新挂载的卡片滑入（wx:key=round 保证旧行不重放动画） */
  animation: cc-card-in 0.32s ease-out both;
}

@keyframes cc-card-in {
  from { opacity: 0; transform: translateY(28rpx) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.cc-card.cc-hit {
  border-color: var(--gp-green, #6aaa64);
  background: var(--gp-green-bg, #eaf3e6);
}

.cc-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 头像由 player-badge 组件绘制（队色渐变 + 首字），这里只负责间距 */
.cc-id {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.cc-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--gp-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cc-en {
  font-size: 22rpx;
}

.cc-round {
  flex-shrink: 0;
}

.cc-round-txt {
  font-size: 22rpx;
  color: var(--gp-text-mute);
}

.cc-hit-badge {
  font-size: 22rpx;
  color: #fff;
  background: var(--gp-green, #6aaa64);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.cc-chips {
  display: flex;
  flex-wrap: wrap;
}

.cc-chip {
  display: inline-flex;
  align-items: baseline;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
  line-height: 1.4;
  /* 逐个弹出：delay 由 wxml 按 index 注入 */
  animation: cc-chip-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes cc-chip-pop {
  from { opacity: 0; transform: scale(0.6); }
  to   { opacity: 1; transform: scale(1); }
}

.cc-arrow {
  margin-left: 6rpx;
  font-size: 24rpx;
}

/* 对局进行中：标签可点（点了就按这条线索筛候选池） */
.cc-chip-tap {
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.5);
}

.cc-chip-press {
  transform: scale(0.93);
  opacity: 0.85;
}
